# Одинаковые переводы строк у всей команды (Windows/Mac)
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew text eol=lf
gradlew.bat text eol=crlf

# Бинарники — без нормализации и без diff'а
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.mp3 binary
*.ogg binary
*.wav binary
*.ttf binary
*.otf binary
*.pdf binary
*.apk binary
*.aab binary
*.jar binary
# Git LFS — крупные ассеты (нужен `git lfs install` у каждого)
*.webp filter=lfs diff=lfs merge=lfs -text
*.mp3  filter=lfs diff=lfs merge=lfs -text
*.ogg  filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text
*.mp4  filter=lfs diff=lfs merge=lfs -text
*.glb  filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.fbx  filter=lfs diff=lfs merge=lfs -text
# Чтобы GitHub не считал проект "PDF-репозиторием"
docs/** linguist-documentation
*.webp !text !filter !merge !diff
*.mp3 !text !filter !merge !diff
*.ogg !text !filter !merge !diff
*.wav !text !filter !merge !diff
*.glb !text !filter !merge !diff
*.gltf !text !filter !merge !diff
*.fbx !text !filter !merge !diff
