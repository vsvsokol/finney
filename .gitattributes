# Одинаковые переводы строк у всей команды (Windows/Mac)
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew text eol=lf
gradlew.bat text eol=crlf

# Бинарники — без нормализации и без diff'а
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.mp3 binary
*.ogg binary
*.wav binary
*.ttf binary
*.otf binary
*.pdf binary
*.apk binary
*.aab binary
*.jar binary
# Git LFS — только то, что действительно большое.
# Графика (webp/png) в LFS НЕ идёт: наши ассеты — единицы и десятки килобайт,
# обычный git с ними справляется, а LFS требует отдельной авторизации,
# расходует квоту GitHub и ломается у всех, кто забыл `git lfs install`.
# Здесь остаётся только видео: резервная запись демонстрации по ТЗ п. 4.1
# может весить сотню мегабайт.
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
# Чтобы GitHub не считал проект "PDF-репозиторием"
docs/** linguist-documentation
# Снимаем с этих расширений LFS-фильтр, оставшийся от прежней настройки.
# Минус, а не «!»: «!» делает атрибут неопределённым, и при core.autocrlf=true
# git начинает считать файл текстом и вырезает CR из байтов картинки.
*.webp -text -filter -merge -diff
*.mp3 -text -filter -merge -diff
*.ogg -text -filter -merge -diff
*.wav -text -filter -merge -diff
*.glb -text -filter -merge -diff
*.gltf -text -filter -merge -diff
*.fbx -text -filter -merge -diff
