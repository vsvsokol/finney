<?xml version="1.0" encoding="utf-8"?>
<!--
   Локальный профиль ребёнка не покидает устройство (ТЗ п. 3.5): ни в облачную копию,
   ни при переносе на новый телефон. Иначе сброс и удаление из раздела взрослого
   могли бы откатиться восстановлением старой копии. Действует с Android 12;
   для более старых версий то же делает allowBackup="false" в манифесте.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
